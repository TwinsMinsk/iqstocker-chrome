{
    "manifest_version":  3,
    "name":  "IQРЎС‚РѕРєРµСЂ Р“РµРЅРµСЂРёРЅРі",
    "version":  "1.0.1",
    "description":  "РђРІС‚РѕРјР°С‚РёР·РёСЂСѓР№ РѕС‚РїСЂР°РІРєСѓ РїСЂРѕРјРїС‚РѕРІ РІ Midjourney С‡РµСЂРµР· Discord",
