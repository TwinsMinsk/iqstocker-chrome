# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Production PostgreSQL URL (замените на свои значения)
DATABASE_URL=postgresql://postgres:your_password@postgres:5432/iqstocker_db

# Для локальной разработки можно использовать SQLite
USE_SQLITE=false

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# JWT & SECURITY
# ===========================================
# !!! ВАЖНО: Сгенерируйте новый SECRET_KEY для production !!!
# Используйте: openssl rand -hex 32
SECRET_KEY=your-secret-key-generate-me-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=30

# Секретный ключ для session tokens (используйте: openssl rand -hex 32)
SESSION_TOKEN_SECRET=session-token-secret-change-me

# ===========================================
# OAUTH GOOGLE (опционально)
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# TELEGRAM TRIBUTE (платежи)
# ===========================================
TRIBUTE_API_KEY=your-tribute-api-key
TRIBUTE_WEBHOOK_SECRET=your-tribute-webhook-secret

# ===========================================
# SENDGRID (email)
# ===========================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# SENTRY (monitoring)
# ===========================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===========================================
# ENVIRONMENT
# ===========================================
ENVIRONMENT=production
DEBUG=false

# ===========================================
# CORS & ALLOWED HOSTS
# ===========================================
# Добавьте ваши production домены (через запятую)
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
ALLOWED_HOSTS=["yourdomain.com","www.yourdomain.com"]

# ===========================================
# API CONFIGURATION
# ===========================================
API_V1_PREFIX=/api/v1

# ===========================================
# SECURITY & PROTECTION
# ===========================================
BATCH_VALIDATION_ENABLED=true
SESSION_TOKEN_TTL_HOURS=1

# Rate limiting
RATE_LIMIT_BATCH_REQUESTS=1
RATE_LIMIT_BATCH_WINDOW=60
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW=60

# Fingerprinting
FINGERPRINTING_ENABLED=false
MAX_DEVICES_PER_LICENSE=3

# Cache TTL
CACHE_PERMISSION_TTL=300

# ===========================================
# EXTENSION DEFAULTS
# ===========================================
DEFAULT_MIN_INTERVAL_MS=15000
DEFAULT_MAX_INTERVAL_MS=300000
DEFAULT_MAX_RETRIES=3

# Free credits for new users
FREE_CREDITS_AMOUNT=1000

# Version check (опционально)
MIN_VERSION_REQUIRED=1.0.0

# Remote selector (опционально)
DISCORD_INPUT_SELECTOR=

